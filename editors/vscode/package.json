{
  "name": "cp-beam-lang",
  "displayName": "CP-BEAM Language Support",
  "description": "Official VS Code extension for the CP-BEAM language. Provides syntax highlighting and LSP-powered intelligence.",
  "version": "0.1.0",
  "publisher": "cp-lang",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cp",
        "aliases": ["Concurrent Plus", "cp"],
        "extensions": [".cp"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cp",
        "scopeName": "source.cp",
        "path": "./syntaxes/cp.tmLanguage.json"
      }
    ]
  },
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.14.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  }
}