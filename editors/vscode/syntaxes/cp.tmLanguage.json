{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Concurrent Plus",
  "patterns": [
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#types"
    }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.cp",
          "match": "\\b(if|else|while|for|return|break|continue|match|defer|errdefer)\\b"
        },
        {
          "name": "keyword.declaration.cp",
          "match": "\\b(fn|let|const|class|interface|trait|impl|enum|error|export|import|from|pub)\\b"
        },
        {
          "name": "keyword.other.cp",
          "match": "\\b(new|await|async|move)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.cp",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.cp",
          "match": "\\\\."
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.cp",
          "match": "//.*$"
        },
        {
          "name": "comment.block.cp",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.cp",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "keyword.control.zig-escape.cp",
          "match": "\\b(__zig__)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.cp",
          "match": "\\b(i32|i64|u32|u64|f32|f64|usize|isize|bool|string|void|any|PID)\\b"
        },
        {
          "name": "entity.name.type.cp",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  },
  "scopeName": "source.cp"
}